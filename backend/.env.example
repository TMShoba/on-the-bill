PORT=4000
NODE_ENV=development

# Supabase Postgres — paste your full URI (replace [YOUR-PASSWORD])
# Session mode (recommended for long-running Node):
# DATABASE_URL=postgresql://postgres.XXXX:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Transaction mode (port 6543) also works with this code:
DATABASE_URL=postgresql://postgres.sudczrczyfrztzgfscew:Mthokozisi%406089@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

JWT_SECRET=K9mP2xR7vL4nQ8wY1tB6cH3jF5sA0dE9gU2iO7kM4pN8rT1vX6z
CORS_ORIGINS=http://localhost:5173,https://on-the-bill.vercel.app
TRUST_PROXY=true
ALLOW_DEMO_TOKENS=true

RATE_LIMIT_API=120
RATE_LIMIT_AUTH=20



# --- Email (booking, acceptance, payment, message and verification emails) ---
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=resend
# SMTP_PASS=
# SMTP_FROM=The LineUp <bookings@thelineup.co.za>
# Frontend URL used for links in emails
APP_URL=http://localhost:5173
# Public URL of this API (calendar feed links, locally stored photos)
# API_PUBLIC_URL=https://api.thelineup.co.za

# --- File storage (chat attachments, artist photos, ID documents) ---
# Leave empty to store files in Postgres (dev only). Use the service role key — server-side only.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# --- Identity verification ---
# Comma-separated emails that can review artist verifications at /admin/verifications.
# Use real staff accounts. (admin@thelineup.co.za is a demo-only account and is ignored in production.)
# ADMIN_EMAILS=you@thelineup.co.za
# Secret for hashing SA ID numbers (defaults to JWT_SECRET) — never change once in use
# ID_HASH_SECRET=
