# Backend API root (with or without trailing /api)
VITE_API_URL=http://localhost:4000

# Image CDN (optional): local | cloudinary | imgix
VITE_IMAGE_CDN=local
VITE_CLOUDINARY_CLOUD=
VITE_IMGIX_DOMAIN=

# PayFast — leave blank to use official sandbox test credentials
VITE_PAYFAST_MERCHANT_ID=
VITE_PAYFAST_MERCHANT_KEY=
# Set "true" only with real live merchant credentials
VITE_PAYFAST_LIVE=false

# Backend public URL used for PayFast notify_url (ITN)
# Example: https://your-api.up.railway.app
VITE_API_PUBLIC_URL=http://localhost:4000
